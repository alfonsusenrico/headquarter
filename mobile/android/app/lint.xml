<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Versions are pinned on purpose and upgraded together. These checks ask the
         network for newer ones and would fail the build whenever one appears. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <!-- UniFFI's generated binding is not ours to change. -->
    <issue id="all">
        <ignore path="src/main/java/uniffi/**" />
    </issue>
</lint>
