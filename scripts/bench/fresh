#!/bin/sh
# Runs a command as if started from a fresh terminal rather than from inside an agent:
# without the variables the host also removes from its launches
# (hq-signals adapters::PARENT_SESSION_MARKERS).
exec env -u AI_AGENT -u CLAUDECODE -u CLAUDE_CODE_BRIDGE_SESSION_ID -u CLAUDE_CODE_CHILD_SESSION \
  -u CLAUDE_CODE_CHROME_MCP_ORG_DENIED -u CLAUDE_CODE_ENTRYPOINT \
  -u CLAUDE_CODE_EVAL_INTERVIEW_SESSION -u CLAUDE_CODE_EXECPATH -u CLAUDE_CODE_HOST_WORKTREE \
  -u CLAUDE_CODE_HOST_WORKTREE_FENCE -u CLAUDE_CODE_MESSAGING_SOCKET \
  -u CLAUDE_CODE_MESSAGING_TOKEN -u CLAUDE_CODE_SESSION_ATTENDED -u CLAUDE_CODE_SESSION_ID \
  -u CLAUDE_EFFORT -u CLAUDE_PID -u CODEX_SANDBOX -u CODEX_SANDBOX_NETWORK_DISABLED \
  -u CODEX_THREAD_ID -u CODEX_TOOL_CALL_ID "$@"
